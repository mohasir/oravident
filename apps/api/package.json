  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external --tsconfig=tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/core/db/seeds/index.ts",
    "db:reset": "tsx src/core/db/scripts/reset.ts",
    "db:permissions": "tsx src/commands/update-permissions.ts",
    "db:roles": "tsx src/commands/update-role-permissions.ts",
    "db:fresh": "npm run db:reset && npm run db:push && npm run db:permissions && npm run db:roles && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:circular": "madge --circular --extensions ts --ts-config tsconfig.json src/"
  },
  "keywords": [],
